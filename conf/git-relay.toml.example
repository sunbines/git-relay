# git-relay 配置模板
# 安装脚本会复制为 /etc/git-relay/git-relay.toml（已存在则不覆盖）
# 手动安装：sudo mkdir -p /etc/git-relay && sudo cp git-relay.toml.example /etc/git-relay/git-relay.toml
# 本文件不含真实密码，也可以用环境变量覆盖：
# GIT_RELAY_HOST / USER / PORT / PASSWORD / KEY / SSH_BACKEND / DOWNLOAD_DIR
# GIT_RELAY_GIT_MODE / GIT_RELAY_GIT_REMOTE / GIT_RELAY_GIT_CACHE_DIR

[remote]
host = "your-server.example.com"
user = "your-user"
port = 22
# password = "your-password"              # 建议改用 GIT_RELAY_PASSWORD 环境变量
# key = "C:/Users/you/.ssh/id_ed25519"    # Linux 可写 ~/.ssh/id_ed25519
# ssh_backend = "auto"                    # auto / openssh / paramiko

[clone]
# depth = 0                 # 0 表示完整历史；1 表示只拉最新提交，速度最快
# branch = ""               # 只克隆指定分支，例如 "main"
# jobs = 4                  # 子模块并发数
# recurse_submodules = false
# remote_git = "git"        # 远端 git 可执行文件路径
download_dir = "/root"        # 默认下载目录：未指定 DEST 时克隆到 <download_dir>/<仓库名>

[git]
# mode = "relay"            # relay: fetch/pull/push 经中转主机访问外网；direct: 本机直接执行 git
# remote = "origin"         # 本地 git 远程名
# cache_dir = ""            # 中转主机上的镜像缓存目录（默认 ~/.cache/git-relay）
