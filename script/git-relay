#!/bin/sh
self=$0
while [ -L "$self" ]; do
    dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)
    target=$(readlink "$self")
    case "$target" in
        /*) self=$target ;;
        *) self=$dir/$target ;;
    esac
done
here=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)
exec python3 "$here/../src/linux/git_relay.py" "$@"
